# ============================================================
#  DREX - AI Desktop Assistant
#  Environment Configuration
#
#  Copy this file to .env and fill in your API keys:
#    cp .env.example .env
#
#  ALL settings are optional — DREX works with at least
#  one AI provider configured.
# ============================================================

# ── Google Gemini API ─────────────────────────────────────────
# Get free key at: https://aistudio.google.com
# Used for general AI chat, reasoning, creative tasks
GEMINI_API_KEY=your_gemini_key_here

# ── Groq API ─────────────────────────────────────────────────
# Get free key at: https://console.groq.com
# Ultra-fast inference — preferred for quick responses
GROQ_API_KEY=your_groq_key_here

# ── OpenRouter API (Optional) ─────────────────────────────────
# Get free key at: https://openrouter.ai
# Access to 100+ models through a single API
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Cerebras API (Optional) ───────────────────────────────────
# Get key at: https://cloud.cerebras.ai
# Ultra-fast inference hardware
CEREBRAS_API_KEY=your_cerebras_key_here

# ── App Settings ──────────────────────────────────────────────
DREX_NAME=Drex
DREX_DEBUG=False
DREX_LOG_LEVEL=INFO
DREX_PERSONALITY=jarvis           # jarvis | friendly | hacker | calm
DREX_THEME=dark

# ── AI Provider Settings ──────────────────────────────────────
# DEFAULT_AI: Primary AI provider (gemini | groq | openrouter | cerebras)
DEFAULT_AI=gemini
DREX_MAX_TOKENS=1024
DREX_TEMPERATURE=0.7
DREX_MAX_HISTORY=20

# ── Voice Settings ────────────────────────────────────────────
DREX_VOICE_ENABLED=true
# TTS_ENGINE: pyttsx3 (offline) | edge (online, better quality)
TTS_ENGINE=edge
# STT_ENGINE: google (online/free) | whisper (offline, requires local model)
STT_ENGINE=google

# ── Wake Word Settings ────────────────────────────────────────
DREX_WAKE_WORD_ENABLED=true
DREX_WAKE_WORD=hey drex
DREX_WAKE_SENSITIVITY=0.5       # 0.0 to 1.0 (lower = more sensitive)

# ── Voice Activity Detection (VAD) ────────────────────────────
DREX_VAD_ENABLED=true
DREX_VAD_MODE=1                  # 0=most aggressive, 3=least
DREX_VAD_SILENCE_DURATION=0.8

# ── GUI Settings ──────────────────────────────────────────────
DREX_GUI_ENABLED=true
DREX_WIN_WIDTH=1100
DREX_WIN_HEIGHT=700